{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcana.tradephantom.com/schemas/ARCANA_Increment.schema.v1.json",
  "title": "ARCANA Conditional Increment Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "risk_model_version", "calibration_profile_id", "decision_horizon", "before", "after", "evidence_hash", "evidence_source_id", "evidence_scope", "valid_from", "expires_at", "binding_hash"],
  "properties": {
    "schema_version": {"const": "arcana.increment.v1"},
    "scope": {"enum": ["upper_model", "calibration_envelope"]},
    "risk_model_version": {"type": "string", "pattern": "^arcana\\.risk\\.v[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
    "calibration_profile_id": {"type": "string", "pattern": "^arcana\\.cal\\.[A-Za-z0-9_.:-]+$"},
    "decision_horizon": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "duration_seconds", "context"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "integer", "minimum": 1},
        "context": {"type": "string", "minLength": 1}
      }
    },
    "before": {"$ref": "#/$defs/snapshot"},
    "after": {"$ref": "#/$defs/snapshot"},
    "evidence_hash": {"$ref": "#/$defs/hash"},
    "evidence_source_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "evidence_scope": {"enum": ["represented_snapshot_pair", "joint_before_after_envelope"]},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "binding_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "upper_model"}}},
      "then": {"properties": {"evidence_scope": {"const": "represented_snapshot_pair"}}},
      "else": {"properties": {"evidence_scope": {"const": "joint_before_after_envelope"}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
    "matrix": {
      "type": "object", "additionalProperties": false,
      "required": ["values", "node_order", "graph_hash"],
      "properties": {
        "values": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}}},
        "node_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "graph_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["upper", "snapshot_hash"],
      "properties": {
        "upper": {"$ref": "#/$defs/matrix"},
        "lower": {"$ref": "#/$defs/matrix"},
        "snapshot_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
