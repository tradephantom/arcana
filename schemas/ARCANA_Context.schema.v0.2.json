{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcana.tradephantom.com/schemas/ARCANA_Context.schema.v0.2.json",
  "title": "ARCANA Risk Context v0.2",
  "type": "object",
  "required": [
    "schema_version",
    "risk_model_version",
    "calibration_profile_id",
    "calibration_level",
    "decision_horizon",
    "graph_hash",
    "rho_interval",
    "decision",
    "reason_codes",
    "evidence",
    "autonomy_budget"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "arcana.context.v0.2"
    },
    "risk_model_version": {
      "type": "string",
      "pattern": "^arcana\\.risk\\.v[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "calibration_profile_id": {
      "type": "string",
      "pattern": "^arcana\\.cal\\.[A-Za-z0-9_.:-]+$"
    },
    "calibration_level": {
      "type": "string",
      "enum": ["A0", "A1", "A2", "A3"]
    },
    "decision_horizon": {
      "$ref": "#/$defs/decision_horizon"
    },
    "graph_hash": {
      "$ref": "#/$defs/sha256_hash"
    },
    "rho_interval": {
      "$ref": "#/$defs/rho_interval"
    },
    "loss_bounds": {
      "$ref": "#/$defs/loss_bounds"
    },
    "fastgate": {
      "$ref": "#/$defs/fastgate"
    },
    "decision": {
      "$ref": "#/$defs/verdict"
    },
    "reason_codes": {
      "$ref": "#/$defs/reason_codes"
    },
    "required_controls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "autonomy_budget": {
      "type": "object",
      "required": ["expires_at"],
      "properties": {
        "max_delta_rho_upper": {
          "type": "number",
          "minimum": 0
        },
        "max_external_requests": {
          "type": "integer",
          "minimum": 0
        },
        "max_memory_writes": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "anyOf": [
        { "required": ["max_delta_rho_upper"] },
        { "required": ["max_external_requests"] },
        { "required": ["max_memory_writes"] },
        { "required": ["max_output_bytes"] }
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256_hash": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "decision_horizon": {
      "type": "object",
      "required": ["id", "duration_seconds", "context"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "duration_seconds": { "type": "integer", "minimum": 1 },
        "context": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "rho_interval": {
      "type": "object",
      "required": ["lower", "mean", "upper", "threshold"],
      "properties": {
        "lower": { "type": "number", "minimum": 0 },
        "mean": { "type": "number", "minimum": 0 },
        "upper": { "type": "number", "minimum": 0 },
        "threshold": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "loss_bounds": {
      "type": "object",
      "required": [
        "aar_99_upper",
        "aes_99_upper",
        "max_allowed_aar_99",
        "max_allowed_aes_99"
      ],
      "properties": {
        "aar_99_upper": { "type": "number", "minimum": 0 },
        "aes_99_upper": { "type": "number", "minimum": 0 },
        "max_allowed_aar_99": { "type": "number", "minimum": 0 },
        "max_allowed_aes_99": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "fastgate": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["perron_collatz_bound", "exact_recompute", "observe_only"]
        },
        "positive_vector_method": {
          "type": "string",
          "enum": [
            "irreducible_perron_vector",
            "scc_decomposition",
            "epsilon_floor",
            "component_local_gate",
            "fallback_exact"
          ]
        },
        "upper_bound": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "perron_collatz_bound"
              }
            }
          },
          "then": {
            "required": ["positive_vector_method", "upper_bound"]
          }
        }
      ],
      "additionalProperties": false
    },
    "verdict": {
      "type": "string",
      "enum": [
        "allow_bounded_autonomy",
        "allow_with_controls",
        "require_scope_reduction",
        "require_human_gate",
        "observe_only",
        "deny"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ARCANA_ALLOW_BOUNDED_AUTONOMY",
          "ARCANA_ALLOW_WITH_CONTROLS",
          "ARCANA_DENY_CALIBRATION_INSUFFICIENT",
          "ARCANA_DENY_RISK_MODEL_UNSUPPORTED",
          "ARCANA_DENY_CONTEXT_STALE",
          "ARCANA_DENY_GRAPH_HASH_MISMATCH",
          "ARCANA_DENY_DECISION_HORIZON_MISMATCH",
          "ARCANA_DENY_RHO_UPPER_BOUND",
          "ARCANA_DENY_AAR_UPPER_BOUND",
          "ARCANA_DENY_AES_UPPER_BOUND",
          "ARCANA_DENY_BUDGET_EXHAUSTED",
          "ARCANA_DENY_FASTGATE_UNCERTAIN",
          "ARCANA_DENY_FASTGATE_VECTOR_INVALID",
          "ARCANA_DENY_DISTILLATION_RISK",
          "ARCANA_REQUIRE_HUMAN_GATE",
          "ARCANA_REQUIRE_SCOPE_REDUCTION",
          "ARCANA_REQUIRE_OBSERVE_ONLY",
          "ARCANA_INFO_A0_NON_CERTIFIABLE",
          "ARCANA_INFO_SYNTHETIC_FIXTURE"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "required": ["source_type", "source_id", "synthetic"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "synthetic_fixture",
            "public_benchmark",
            "controlled_test",
            "hash_bound_context"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_hash": {
          "$ref": "#/$defs/sha256_hash"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
