{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcana.tradephantom.com/schemas/ARCANA_Temporal.schema.v1.json",
  "title": "ARCANA Conditional Temporal Propagation Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "risk_model_version", "calibration_profile_id", "decision_horizon", "generations", "operators", "envelope_upper", "initial_upper", "operator_semantics", "state_units", "exogenous_input", "evidence_hash", "evidence_source_id", "evidence_scope", "valid_from", "expires_at", "binding_hash"],
  "properties": {
    "schema_version": {"const": "arcana.temporal.v1"},
    "mode": {"enum": ["fixed_operator", "common_envelope"]},
    "risk_model_version": {"type": "string", "pattern": "^arcana\\.risk\\.v[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
    "calibration_profile_id": {"type": "string", "pattern": "^arcana\\.cal\\.[A-Za-z0-9_.:-]+$"},
    "decision_horizon": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "duration_seconds", "context"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "integer", "minimum": 1},
        "context": {"type": "string", "minLength": 1}
      }
    },
    "generations": {"type": "integer", "minimum": 1, "maximum": 256},
    "operators": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/matrix"}},
    "envelope_upper": {"$ref": "#/$defs/matrix"},
    "initial_upper": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "number", "minimum": 0}},
    "operator_semantics": {"const": "per_generation_expected_offspring"},
    "state_units": {"const": "expected_unsafe_activations"},
    "exogenous_input": {"const": "none_after_initial"},
    "evidence_hash": {"$ref": "#/$defs/hash"},
    "evidence_source_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "evidence_scope": {"const": "joint_generation_envelope"},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "binding_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [{"if": {"properties": {"mode": {"const": "fixed_operator"}}}, "then": {"properties": {"operators": {"maxItems": 1}}}}],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
    "matrix": {
      "type": "object", "additionalProperties": false,
      "required": ["values", "node_order", "graph_hash"],
      "properties": {
        "values": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "number", "minimum": 0}}},
        "node_order": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "graph_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
